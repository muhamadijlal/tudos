generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

enum TaskStatus {
  todo
  in_progress
  in_review
  done
}

enum TaskPriority {
  low
  medium
  high
}

model Role {
  id          Int      @id @default(autoincrement()) @db.UnsignedInt
  name        String   @unique(map: "unq_role_name") @db.VarChar(50)
  description String?  @db.VarChar(255)
  isSystem    Boolean  @default(false) @map("is_system")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamp(0)

  // Relations
  users       User[]
  permissions RolePermission[]

  @@map("roles")
}

model Permission {
  id    Int    @id @default(autoincrement()) @db.UnsignedInt
  key   String @unique(map: "unq_permission_key") @db.VarChar(100)
  label String @db.VarChar(150)
  group String @db.VarChar(50)

  // Relations
  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       Int @map("role_id") @db.UnsignedInt
  permissionId Int @map("permission_id") @db.UnsignedInt

  // Relations
  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "fk_role_permission_role")
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "fk_role_permission_permission")

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model User {
  id        Int       @id @default(autoincrement()) @db.UnsignedInt
  name      String    @db.VarChar(100)
  email     String    @unique(map: "unq_user_email") @db.VarChar(150)
  password  String    @db.VarChar(255)
  roleId    Int       @map("role_id") @db.UnsignedInt
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamp(0)
  deletedAt DateTime? @map("deleted_at") @db.Timestamp(0)

  // Dipakai buat export Daily Activity (laporan .xlsx). fullName/nik/department
  // adalah identitas resmi user itu sendiri (tanda tangan kanan) — diisi wajib
  // pas register buat user baru; user lama (null) dilengkapi lewat popup export.
  // supervisor* data atasan/Penanggung Jawab (tanda tangan kiri), diisi lewat
  // popup export & disimpen ke sini biar gak nanya ulang dari nol tiap export.
  fullName        String? @map("full_name") @db.VarChar(150)
  nik             String? @db.VarChar(8)
  department      String? @db.VarChar(100)
  supervisorName  String? @map("supervisor_name") @db.VarChar(150)
  supervisorNik   String? @map("supervisor_nik") @db.VarChar(8)
  supervisorTitle String? @map("supervisor_title") @db.VarChar(150)
  // Path relatif ke file di disk (storage/profile_picture/xxx.jpg), bukan URL
  // publik langsung — diserve lewat GET /users/:id/profile-picture (lihat
  // user.controller.js) biar tetap lewat autentikasi kayak attachment task.
  profilePicture  String? @map("profile_picture") @db.VarChar(255)

  // Relations
  role            Role                @relation(fields: [roleId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "fk_user_role")
  ownedProjects   Project[] // User sebagai pemilik project (1:N)
  taskAssignments TaskAssignee[] // User sebagai salah satu assignee task (M:N lewat TaskAssignee)
  refreshTokens   RefreshToken[]
  taskComments    TaskComment[]
  statusChanges   TaskStatusHistory[]
  notifications   Notification[]

  // Indexes
  @@index([roleId], map: "idx_user_role_id")
  @@map("users")
}

model RefreshToken {
  id        Int       @id @default(autoincrement()) @db.UnsignedInt
  userId    Int       @map("user_id") @db.UnsignedInt
  tokenHash String    @unique(map: "unq_refresh_token_hash") @map("token_hash") @db.VarChar(255)
  expiresAt DateTime  @map("expires_at") @db.Timestamp(0)
  revokedAt DateTime? @map("revoked_at") @db.Timestamp(0)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamp(0)

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "fk_refresh_token_user")

  // Indexes
  @@index([userId], map: "idx_refresh_token_user_id")
  @@map("refresh_tokens")
}

model Project {
  id          Int       @id @default(autoincrement()) @db.UnsignedInt
  userId      Int       @map("user_id") @db.UnsignedInt
  code        String    @unique(map: "unq_project_code") @db.VarChar(10)
  taskCounter Int       @default(0) @map("task_counter")
  name        String    @db.VarChar(100)
  description String?   @db.Text
  startDate   DateTime? @map("start_date") @db.Timestamp(0)
  dueDate     DateTime? @map("due_date") @db.Timestamp(0)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamp(0)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamp(0)

  // Relations
  user  User          @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "fk_project_user")
  tasks Task[]
  notes ProjectNote[]

  // Indexes
  @@index([userId], map: "idx_project_user_id")
  @@map("projects")
}

model ProjectNote {
  id        Int       @id @default(autoincrement()) @db.UnsignedInt
  projectId Int       @map("project_id") @db.UnsignedInt
  title     String    @db.VarChar(150)
  content   String?   @db.Text
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamp(0)
  deletedAt DateTime? @map("deleted_at") @db.Timestamp(0)

  // Relations
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "fk_project_note_project")

  // Indexes
  @@index([projectId], map: "idx_project_note_project_id")
  @@map("project_notes")
}

model Task {
  id          Int          @id @default(autoincrement()) @db.UnsignedInt
  projectId   Int          @map("project_id") @db.UnsignedInt
  categoryId  Int          @map("category_id") @db.UnsignedInt
  sequence    Int
  name        String       @db.VarChar(100)
  description String?      @db.Text
  priority    TaskPriority @default(medium)
  status      TaskStatus   @default(todo)
  startDate   DateTime?    @map("start_date") @db.Timestamp(0)
  dueDate     DateTime?    @map("due_date") @db.Timestamp(0)
  // Dipakai buat pengelompokan export Daily Activity — beda dari createdAt
  // (dikunci ke saat task beneran dibuat, gak bisa diubah), field ini bebas
  // di-set/diubah user ke tanggal manapun (termasuk yang udah lewat), buat
  // nyatet "task ini dikerjain tanggal berapa" secara retroaktif. Defaultnya
  // hari ini pas bikin task baru, wajib diisi (NOT NULL).
  reportDate  DateTime     @default(now()) @map("tgl_laporan") @db.Timestamp(0)
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt   DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamp(0)
  deletedAt   DateTime?    @map("deleted_at") @db.Timestamp(0)

  // Relations
  project       Project             @relation(fields: [projectId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "fk_task_project")
  category      Category            @relation(fields: [categoryId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "fk_task_category")
  attachments   TaskAttachment[]
  assignees     TaskAssignee[]
  comments      TaskComment[]
  statusHistory TaskStatusHistory[]
  notifications Notification[]

  // Indexes
  @@unique([projectId, sequence], map: "unq_task_project_sequence")
  @@index([categoryId], map: "idx_task_category_id")
  @@map("tasks")
}

// Komentar bebas di 1 task (ala Jira) — beda dari TaskStatusHistory.note yang
// khusus nempel di 1 event perpindahan status. Hard-delete (gak ada
// deletedAt) sama kayak TaskAttachment, soalnya komentar sifatnya transient.
model TaskComment {
  id        Int      @id @default(autoincrement()) @db.UnsignedInt
  taskId    Int      @map("task_id") @db.UnsignedInt
  userId    Int      @map("user_id") @db.UnsignedInt
  // Cuma 2 level: null = komentar utama, keisi = balasan ke komentar utama.
  // Balasan gak boleh punya balasan lagi — dicek di task-comment.service.js
  // (parent yang ditunjuk harus komentar utama, bukan balasan lain).
  parentId  Int?     @map("parent_id") @db.UnsignedInt
  content   String   @db.Text
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(0)

  // Relations
  task          Task           @relation(fields: [taskId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "fk_task_comment_task")
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "fk_task_comment_user")
  parent        TaskComment?   @relation("TaskCommentReplies", fields: [parentId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "fk_task_comment_parent")
  replies       TaskComment[]  @relation("TaskCommentReplies")
  notifications Notification[]

  // Indexes
  @@index([taskId], map: "idx_task_comment_task_id")
  @@index([parentId], map: "idx_task_comment_parent_id")
  @@map("task_comments")
}

// Log tiap kali status task berubah (todo -> in_progress -> in_review -> ...)
// — `note` cuma keisi kalau perpindahannya "dikembalikan" dari In Review ke
// Todo/In Progress (wajib diisi di situ, lihat assertReviewNote di
// task.service.js), transisi lain `note`-nya null.
model TaskStatusHistory {
  id         Int        @id @default(autoincrement()) @db.UnsignedInt
  taskId     Int        @map("task_id") @db.UnsignedInt
  userId     Int        @map("user_id") @db.UnsignedInt
  fromStatus TaskStatus @map("from_status")
  toStatus   TaskStatus @map("to_status")
  note       String?    @db.Text
  createdAt  DateTime   @default(now()) @map("created_at") @db.Timestamp(0)

  // Relations
  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "fk_task_status_history_task")
  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "fk_task_status_history_user")

  // Indexes
  @@index([taskId], map: "idx_task_status_history_task_id")
  @@map("task_status_history")
}

// Notifikasi in-app buat assignee waktu task mereka selesai direview (owner
// approve ke Done, atau kembaliin ke Todo/In Progress). Cuma dibuat buat 2
// event itu (lihat task.service.js), bukan tiap perpindahan status.
model Notification {
  id        Int       @id @default(autoincrement()) @db.UnsignedInt
  userId    Int       @map("user_id") @db.UnsignedInt
  taskId    Int       @map("task_id") @db.UnsignedInt
  // Diisi cuma buat notifikasi komentar/balasan — dipakai frontend buat
  // nge-highlight & scroll-ke komentar yang dimaksud pas notifikasinya
  // diklik. Nullable + SetNull: kalau komentarnya kehapus, notifikasinya
  // sendiri tetep ada (cuma referensinya ilang), gak ikut kehapus.
  commentId Int?      @map("comment_id") @db.UnsignedInt
  type      String    @db.VarChar(50)
  message   String    @db.VarChar(255)
  readAt    DateTime? @map("read_at") @db.Timestamp(0)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamp(0)

  // Relations
  user    User         @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "fk_notification_user")
  task    Task         @relation(fields: [taskId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "fk_notification_task")
  comment TaskComment? @relation(fields: [commentId], references: [id], onDelete: SetNull, onUpdate: Cascade, map: "fk_notification_comment")

  // Indexes
  @@index([userId], map: "idx_notification_user_id")
  @@index([taskId], map: "idx_notification_task_id")
  @@index([commentId], map: "idx_notification_comment_id")
  @@map("notifications")
}

model TaskAssignee {
  taskId Int @map("task_id") @db.UnsignedInt
  userId Int @map("user_id") @db.UnsignedInt

  // Relations
  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "fk_task_assignee_task")
  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "fk_task_assignee_user")

  // Indexes
  @@id([taskId, userId])
  @@index([userId], map: "idx_task_assignee_user_id")
  @@map("task_assignees")
}

model TaskAttachment {
  id        Int      @id @default(autoincrement()) @db.UnsignedInt
  taskId    Int      @map("task_id") @db.UnsignedInt
  path      String   @db.VarChar(255)
  name      String   @db.VarChar(255)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(0)

  // Relations
  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "fk_task_attachment_task")

  // Indexes
  @@index([taskId], map: "idx_task_attachment_task_id")
  @@map("task_attachments")
}

model Category {
  id        Int       @id @default(autoincrement()) @db.UnsignedInt
  name      String    @unique(map: "unq_category_name") @db.VarChar(50)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamp(0)
  deletedAt DateTime? @map("deleted_at") @db.Timestamp(0)

  // Relations
  tasks Task[]

  @@map("categories")
}

// Master kalender libur nasional Indonesia — dipakai export Daily Activity
// buat ngosongin + nge-merah-in baris tanggal itu (sama kayak weekend), dan
// buat geser task yang jatuh di tanggal itu ke hari kerja berikutnya.
model NationalHoliday {
  id        Int      @id @default(autoincrement()) @db.UnsignedInt
  date      DateTime @unique(map: "unq_national_holiday_date") @db.Date
  name      String   @db.VarChar(150)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamp(0)

  @@map("national_holidays")
}
